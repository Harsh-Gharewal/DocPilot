# ==========================================
# API Keys & LLM Provider Configuration
# ==========================================
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LLM_PROVIDER options: "openai" or "anthropic"
LLM_PROVIDER=openai

# Model names
OPENAI_CHAT_MODEL=gpt-4o
ANTHROPIC_CHAT_MODEL=claude-3-5-sonnet-20241022
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ==========================================
# Data & Indexing Paths
# ==========================================
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
CHROMA_DIR=data/chroma
BM25_DIR=data/bm25

# ==========================================
# Chunking Defaults
# ==========================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
DEFAULT_CHUNKING_STRATEGY=structure_aware

# Deduplication similarity threshold (cosine similarity > threshold is duplicate)
DEDUP_SIMILARITY_THRESHOLD=0.95

# ==========================================
# Retrieval & RRF Defaults
# ==========================================
TOP_K_RETRIEVAL=10
TOP_K_RERANK=5
RRF_K=60
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3
RERANKER_BACKEND=cross-encoder
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ==========================================
# Generation & Confidence Thresholds
# ==========================================
CONFIDENCE_THRESHOLD_NO_ANSWER=0.5
CONFIDENCE_WEIGHT_RETRIEVAL=0.4
CONFIDENCE_WEIGHT_CITATION=0.4
CONFIDENCE_WEIGHT_COMPLETENESS=0.2

# ==========================================
# API Server & Auth
# ==========================================
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=rag-internal-dev-key
